# Salin ke .env.local. JANGAN commit .env.local atau secret nyata.
# Lokal dev (supabase start): URL=http://127.0.0.1:54321, ANON_KEY dan SERVICE_ROLE_KEY dari `supabase status`
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Hanya server. Tidak boleh berawalan NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# AI Gateway (provider-agnostic). Isi sesuai provider yang dipilih.
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1536

# Konfigurasi RAG (berversi lewat ADR/eval)
RAG_RELEVANCE_THRESHOLD=
RAG_TOP_K=5

# Kanal resmi Disdukcapil untuk template fallback. Isi dari sumber resmi, jangan dari pengetahuan model.
OFFICIAL_CHANNEL_TEXT=
OFFICIAL_CHANNEL_URL=https://sidnok.semarangkota.go.id/

# Rate limit & batas input
CHAT_MAX_INPUT_CHARS=1000
CHAT_RATE_LIMIT_PER_MIN=10

# Retensi (hari), konfirmasikan dengan Disdukcapil
RETENTION_DAYS_CHAT_EVENTS=90

# Kuota chat harian (usulan, disetel dari biaya model; lihat PRD 3.5)
QUOTA_ANON_PER_DAY=5
QUOTA_USER_PER_DAY=20
